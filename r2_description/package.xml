<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_description</name>
  <version>0.1.0</version>
  <description>
    URDF/xacro description of the R2 holonomic (mecanum) mobile base: chassis,
    four mecanum wheels, RGB-D camera, 2D LIDAR and IMU. Simulation-agnostic
    apart from the optional Gazebo sensor block.
  </description>
  <maintainer email="phumint1969@gmail.com">phumint</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Provides the gz_ros2_control/GazeboSimSystem hardware plugin named in
       r2.ros2_control.xacro. -->
  <exec_depend>gz_ros2_control</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
