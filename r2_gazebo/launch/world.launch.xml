<?xml version="1.0"?>
<!--
  Starts Gazebo Harmonic and the ROS <-> Gazebo topic bridge.

  Does NOT spawn the robot; see spawn_robot.launch.xml. Kept separate so a world
  can be inspected on its own, and so the bridge (which is world-scoped, not
  robot-scoped) has exactly one owner.
-->
<launch>

  <arg name="world"
       default="$(find-pkg-share r2_gazebo)/worlds/empty.sdf"
       description="Absolute path to the world SDF. Any replacement must keep the
                    Sensors and Imu system plugins or the robot's sensors go silent."/>
  <arg name="gui" default="true"
       description="Run the Gazebo GUI. false gives a headless server, for CI."/>
  <arg name="paused" default="false"
       description="Start paused. The controller spawners tolerate this via
                    their switch-timeout."/>
  <arg name="bridge_config"
       default="$(find-pkg-share r2_gazebo)/config/ros_gz_bridge.yaml"/>

  <!--
    Physics engine OVERRIDE. Empty means "use whatever the world asks for", which
    is the right default: the engine belongs with the world, not with the launch.
    empty.sdf says nothing and so gets gz sim's default (dartsim), which is what
    every measured number in this package's README was recorded on.
    robocon2027_field's worlds declare dartsim too (<physics type="ode">), and
    that is deliberate: dartsim is the only engine this robot drives correctly
    on. bullet and bullet-featherstone cannot reproduce the anisotropic fdir1
    friction a mecanum base needs, so the robot cannot strafe on them at all.
    Do not change this to buy back the full world's real-time factor. See the
    field package README.

    This argument exists so the engines can be compared without editing an SDF:
      ros2 launch ... physics_engine:=gz-physics-bullet-featherstone-plugin
      ros2 launch ... physics_engine:=gz-physics-dartsim-plugin
  -->
  <arg name="physics_engine" default=""
       description="Blank to honour the world's own choice. Otherwise a gz-physics
                    engine plugin name, which overrides the world."/>

  <!--
    Assemble the gz command line:
      -s   server only (no GUI)
      -r   run immediately rather than starting paused
      -v3  warnings and errors, without the per-frame chatter of -v4
  -->
  <let name="gz_args"
       value="$(eval &quot;('-s ' if '$(var gui)' == 'false' else '') + ('' if '$(var paused)' == 'true' else '-r ') + ('' if '$(var physics_engine)' == '' else '--physics-engine $(var physics_engine) ') + '-v3 $(var world)'&quot;)"/>

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="$(var gz_args)"/>
    <arg name="on_exit_shutdown" value="true"/>
  </include>

  <!--
    One bridge process for every sensor plus the clock. Per-topic QoS and
    frame_id come from the YAML, which is why there is no long argument list
    here.
  -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="ros_gz_bridge" output="screen">
    <param name="config_file" value="$(var bridge_config)"/>
    <param name="use_sim_time" value="true"/>
  </node>

</launch>
