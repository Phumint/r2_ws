<?xml version="1.0"?>
<!--
  TOP-LEVEL SIMULATION LAUNCH.

  Composes: Gazebo world + sensor bridge + robot + controllers + localisation
  (+ RViz). This is the everyday entry point.

  Usage:
    ros2 launch r2_bringup sim.launch.xml
    ros2 launch r2_bringup sim.launch.xml contact_model:=rollers
    ros2 launch r2_bringup sim.launch.xml gui:=false rviz:=false     # headless

  Drive it:
    (see the package README for the teleop command; it cannot be written here
     because XML comments may not contain a double hyphen)
-->
<launch>

  <arg name="world" default="$(find-pkg-share r2_gazebo)/worlds/empty.sdf"
       description="World SDF. Must retain the Sensors and Imu system plugins."/>
  <arg name="gui" default="true" description="Gazebo GUI."/>
  <arg name="rviz" default="true" description="Start RViz with the sim config."/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>

  <arg name="contact_model" default="friction"
       description="friction | rollers. See r2_description/README.md."/>
  <arg name="publish_roller_states" default="false"/>
  <arg name="mecanum_mu_slip" default="0.05"/>
  <arg name="mecanum_mu_grip" default="1.0"/>
  <arg name="use_ground_truth" default="true"
       description="Publish /ground_truth/odom for scoring odometry and the EKF."/>
  <arg name="localization" default="true"
       description="Run the EKF. Set false to inspect raw wheel odometry alone."/>

  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.15"/>
  <arg name="yaw" default="0.0"/>

  <arg name="controllers_file"
       default="$(find-pkg-share r2_control)/config/r2_controllers.yaml"/>
  <arg name="ekf_config"
       default="$(find-pkg-share r2_bringup)/config/ekf.yaml"/>

  <!-- 1. Simulator + ROS/Gazebo bridge -->
  <include file="$(find-pkg-share r2_gazebo)/launch/world.launch.xml">
    <arg name="world" value="$(var world)"/>
    <arg name="gui" value="$(var gui)"/>
    <arg name="paused" value="$(var paused)"/>
  </include>

  <!-- 2. Robot description + spawn -->
  <include file="$(find-pkg-share r2_gazebo)/launch/spawn_robot.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="contact_model" value="$(var contact_model)"/>
    <arg name="use_ground_truth" value="$(var use_ground_truth)"/>
    <arg name="mecanum_mu_slip" value="$(var mecanum_mu_slip)"/>
    <arg name="mecanum_mu_grip" value="$(var mecanum_mu_grip)"/>
    <arg name="publish_roller_states" value="$(var publish_roller_states)"/>
    <arg name="controllers_file" value="$(var controllers_file)"/>
    <arg name="x" value="$(var x)"/>
    <arg name="y" value="$(var y)"/>
    <arg name="z" value="$(var z)"/>
    <arg name="yaw" value="$(var yaw)"/>
  </include>

  <!-- 3. Controllers + teleop multiplexer -->
  <include file="$(find-pkg-share r2_control)/launch/control.launch.xml">
    <arg name="controllers_file" value="$(var controllers_file)"/>
  </include>

  <!-- 4. Localisation -->
  <group if="$(var localization)">
    <include file="$(find-pkg-share r2_bringup)/launch/localization.launch.xml">
      <arg name="ekf_config" value="$(var ekf_config)"/>
    </include>

    <!--
      Anchor the ground-truth frame to the TF tree.

      The odometry-publisher plugin stamps /ground_truth/odom with
      ground_truth_odom, and nothing else in the tree ever mentions that frame.
      Any consumer using a tf2 MessageFilter (RViz's Odometry display above all)
      then holds every message waiting for a transform that never arrives, fills
      its queue and drops them:

        Message Filter dropping message: frame 'ground_truth_odom'
        for reason 'discarding message because the queue is full'

      ground_truth_odom IS the Gazebo world frame: the plugin reports the WORLD
      pose of base_footprint. Measured, not assumed - spawning at x:=2.0 y:=1.0
      makes /ground_truth/odom read (2.0, 1.0) while the EKF reads ~0, because
      the EKF instead anchors odom at the robot's initial pose. So odom sits at
      the spawn pose within the world, and the transform below is the INVERSE of
      that spawn pose. For the default origin spawn it is the identity.

      DIRECTION IS NOT ARBITRARY. This is published parent-to-child as
      odom -> ground_truth_odom, which leaves ground_truth_odom a leaf. The
      reverse is tempting because it needs no arithmetic - it would be the spawn
      pose directly - but it makes odom a CHILD of ground_truth_odom, and the
      day nav2 starts publishing map -> odom that frame would have two parents
      and the tree would break.

      Pinning the two origins together is what makes the RViz overlay mean
      something: the visible gap between the two odometry traces is then exactly
      the estimate error.

      This declares a frame relationship. It does not subscribe to
      /ground_truth/odom, so the rule that no control or localisation node may
      consume ground truth is untouched.
    -->
    <group if="$(var use_ground_truth)">
      <let name="gt_x"
           value="$(command 'python3 -c &quot;import math,sys; x,y,t=[float(v) for v in sys.argv[1:4]]; sys.stdout.write(repr(-x*math.cos(t) - y*math.sin(t)))&quot; $(var x) $(var y) $(var yaw)')"/>
      <let name="gt_y"
           value="$(command 'python3 -c &quot;import math,sys; x,y,t=[float(v) for v in sys.argv[1:4]]; sys.stdout.write(repr(x*math.sin(t) - y*math.cos(t)))&quot; $(var x) $(var y) $(var yaw)')"/>
      <let name="gt_yaw"
           value="$(command 'python3 -c &quot;import sys; sys.stdout.write(repr(-float(sys.argv[1])))&quot; $(var yaw)')"/>

      <node pkg="tf2_ros" exec="static_transform_publisher"
            name="ground_truth_odom_anchor" output="log"
            args="--frame-id odom --child-frame-id ground_truth_odom
                  --x $(var gt_x) --y $(var gt_y) --yaw $(var gt_yaw)">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
      </node>
    </group>
  </group>

  <!-- 5. Visualisation -->
  <group if="$(var rviz)">
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
          args="-d $(find-pkg-share r2_gazebo)/config/r2_sim.rviz">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>

</launch>
