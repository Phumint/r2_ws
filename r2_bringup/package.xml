<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r2_bringup</name>
  <version>0.1.0</version>
  <description>
    Top-level composition for the R2 mecanum base, plus the wheel-odometry/IMU
    fusion configuration. Start here: sim.launch.xml brings up the whole stack.
  </description>
  <maintainer email="phumint1969@gmail.com">phumint</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>r2_description</exec_depend>
  <exec_depend>r2_control</exec_depend>
  <exec_depend>r2_gazebo</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>xacro</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
